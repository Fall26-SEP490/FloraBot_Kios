{
  "name": "florabot-kiosk",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "pnpm --filter @florabot/kiosk dev",
    "build": "pnpm --filter @florabot/kiosk build",
    "typecheck": "pnpm --filter @florabot/kiosk typecheck",
    "lint": "eslint apps packages tests --max-warnings=0",
    "test": "pnpm build && playwright test --config playwright.kiosk.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.39.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "openapi-typescript": "^7.10.1",
    "pa11y-ci": "^5.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
